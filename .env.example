# ---------- BACKEND: PURE LOCAL SQLite ONLY (no external Supabase) — RECOMMENDED for finance/sensitive data ----------
# Set FORCE_SQLITE=true to skip Supabase entirely — the app will ONLY use the local SQLite file,
# no connection to any external DB is ever attempted.
# SQLite DB file is stored at backend/echios_local.db relative to project root.
FORCE_SQLITE=true
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./backend/echios_local.db

# ---------- BACKEND (Supabase Postgres via SQLAlchemy asyncpg) --- OPTIONAL, uncomment to use cloud DB ---
# To enable Supabase instead of local SQLite:
#   1) Set FORCE_SQLITE=false
#   2) Uncomment and fill in DATABASE_URL below
# Copy the Supabase "Connection string -> URI" from:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Format:  postgresql://user:password@host:5432/postgres
# FORCE_SQLITE=false
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# USE_SQLITE_FALLBACK=true

# ---------- GenAI: Anthropic direct OR LiteLLM proxy (pick ONE set; LiteLLM wins if both set) ----------
# (A) Direct Anthropic: get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
# (B) LiteLLM / OpenRouter / self-hosted proxy: any OpenAI-compatible base URL
#     e.g. your custom Litellm proxy + Nova / AWS Nova model:
LITELLM_API_BASE=https://abc.echios.tech
LITELLM_API_KEY=sk-iuoiuoiu
LITELLM_MODEL=nova

# ---------- Auth: JWT + default admin ----------
# !! CHANGE JWT_SECRET IN PRODUCTION — must be long random string (>=32 chars)
JWT_SECRET=replace-me-with-a-long-random-string-like-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Seeded on first startup if no users exist yet. CHANGE DEFAULT PASSWORD AFTER FIRST LOGIN.
DEFAULT_ADMIN_EMAIL=admin@echios.local
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Platform Admin

# ---------- Backend CORS (frontend origin) ----------
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Backend bind ----------
HOST=0.0.0.0
PORT=8000

# ---------- AI assistant account context + simulation clock ----------
# The selected client is controlled server-side and is never accepted from the browser.
ASSISTANT_CLIENT_ID=1
# Optional YYYY-MM-DD override. Defaults to the server's current date.
# SIMULATION_AS_OF=2026-08-04

# ---------- Local CSV semantic retrieval ----------
# Embeddings are generated locally with ONNX and cached in a SQLite index.
ASSISTANT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional absolute path; defaults to backend/.cache/simulated_market_vectors.sqlite3
# ASSISTANT_VECTOR_INDEX_PATH=C:/path/to/simulated_market_vectors.sqlite3
ASSISTANT_SEMANTIC_RESULT_LIMIT=8
# Change this label when the AssistantUserRepository is switched to SQLite.
ASSISTANT_USER_DATA_SOURCE_LABEL=Supabase database
