# ---------- BACKEND (Supabase Postgres via SQLAlchemy asyncpg) ----------
# Copy the Supabase "Connection string -> URI" from:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Format:  postgresql://user:password@host:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ---------- GenAI: Anthropic direct OR LiteLLM proxy (pick ONE set; LiteLLM wins if both set) ----------
# (A) Direct Anthropic: get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
# (B) LiteLLM / OpenRouter / self-hosted proxy: any OpenAI-compatible base URL
#     e.g. your custom Litellm proxy + Nova / AWS Nova model:
LITELLM_API_BASE=https://abc.echios.tech
LITELLM_API_KEY=sk-iuoiuoiu
LITELLM_MODEL=nova

# ---------- Backend CORS (frontend origin) ----------
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Backend bind ----------
HOST=0.0.0.0
PORT=8000

# ---------- AI assistant temporary identity + simulation clock ----------
# Replace this stub with Clerk's server-side user-to-client mapping when auth lands.
ASSISTANT_STUB_CLIENT_ID=1
# Optional YYYY-MM-DD override. Defaults to the server's current date.
# SIMULATION_AS_OF=2026-08-04
